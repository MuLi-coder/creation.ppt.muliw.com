          "w": 0.8128,
          "h": 0.1674
        },
        {
          "type": "text",
          "text": "面向遮挡与堆叠场景的机器人主动感知与智能抓取方法研究",
          "x": 0.2823,
          "y": 0.4123,
          "w": 0.4359,
